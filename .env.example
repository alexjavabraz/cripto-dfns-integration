# ============================================================
# DFNS Integration - Environment Variables
# ============================================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control

# --- Application ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- DFNS Service Account ---
DFNS_API_URL=https://api.dfns.io
DFNS_APP_ID=ap-...
DFNS_AUTH_TOKEN=eyJ0...
DFNS_CRED_ID=Y2...
# PEM-formatted private key (use \n for newlines in single line)
DFNS_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"

# --- Blockchain RPC Endpoints ---
RPC_ETHEREUM=https://mainnet.infura.io/v3/YOUR_KEY
RPC_POLYGON=https://polygon-mainnet.infura.io/v3/YOUR_KEY
RPC_ARBITRUM=https://arbitrum-mainnet.infura.io/v3/YOUR_KEY

# --- Wallet IDs per network (pre-created DFNS wallets) ---
DFNS_WALLET_ETHEREUM=wa-...
DFNS_WALLET_POLYGON=wa-...
DFNS_WALLET_ARBITRUM=wa-...

# --- RabbitMQ ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=token.create
RABBITMQ_PREFETCH=1
# Exchange where BFF publishes (dfns-integration binds its listen queue here)
EXCHANGE_REQUEST_TOKEN_CREATION=bff_publish_token_creation_request
# Queue where dfns-integration listens for token creation requests (bound to EXCHANGE_REQUEST_TOKEN_CREATION)
QUEUE_REQUEST_TOKEN_CREATION=dfns_listen_token_creation_request
# Exchange where dfns-integration publishes results (BFF listens here)
EXCHANGE_RESPONSE_TOKEN_CREATED=dfns_publish_token_creation_response
RABBITMQ_ERROR_EXCHANGE=token_creation_error

# Balance query
QUEUE_GET_BALANCE=queue_get_balance
EXCHANGE_BALANCE_RESPONSE=balance_response

# Token event operations (mint, burn, pause, unpause)
TOKEN_EVENT=token_event
QUEUE_TOKEN_EVENT=token_event.queue
EXCHANGE_TOKEN_EVENT_RESPONSE=token_event_response

# --- Sentry ---
SENTRY_DSN=https://...@sentry.io/...

# --- Smoke test (optional) ---
# SMOKE_TEST=true
# TEST_OWNER_ADDRESS=0x...
