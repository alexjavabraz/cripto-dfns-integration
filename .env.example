# ============================================================
# DFNS Integration - Environment Variables
# ============================================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control

# --- Application ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- DFNS Service Account ---
DFNS_API_URL=https://api.dfns.io
DFNS_APP_ID=ap-...
DFNS_AUTH_TOKEN=eyJ0...
DFNS_CRED_ID=Y2...
# PEM-formatted private key (use \n for newlines in single line)
DFNS_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"

# --- Blockchain RPC Endpoints ---
RPC_ETHEREUM=https://mainnet.infura.io/v3/YOUR_KEY
RPC_POLYGON=https://polygon-mainnet.infura.io/v3/YOUR_KEY
RPC_ARBITRUM=https://arbitrum-mainnet.infura.io/v3/YOUR_KEY

# --- Wallet IDs per network (pre-created DFNS wallets) ---
DFNS_WALLET_ETHEREUM=wa-...
DFNS_WALLET_POLYGON=wa-...
DFNS_WALLET_ARBITRUM=wa-...

# --- RabbitMQ ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=token.create
RABBITMQ_PREFETCH=1
RABBITMQ_CREATION_QUEUE=token_creation_request
RABBITMQ_CREATED_EXCHANGE=token_created
RABBITMQ_ERROR_EXCHANGE=token_creation_error

# --- Sentry ---
SENTRY_DSN=https://...@sentry.io/...
