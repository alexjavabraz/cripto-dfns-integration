{
  "name": "dfns_integration",
  "version": "1.0.0",
  "description": "Secure DFNS token deployment service - ERC-20/721/1155 via RabbitMQ",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc && npm run compile:contracts",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\" \"contracts/**/*.sol\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "compile:contracts": "hardhat compile",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --passWithNoTests --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dfns/sdk": "^0.8.20",
    "@dfns/sdk-keysigner": "^0.8.20",
    "@fastify/helmet": "^12.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@sentry/node": "^8.40.0",
    "amqplib": "^0.10.4",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "fastify": "^5.2.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.1.0",
    "@types/amqplib": "^0.10.5",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "hardhat": "^2.22.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^2.1.0"
  }
}
